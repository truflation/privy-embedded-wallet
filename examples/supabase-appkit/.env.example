# Server (read by server.ts, never sent to the browser)
# Privy app id from the Privy dashboard.
PRIVY_APP_ID=
# Privy app secret. Keep it server side.
PRIVY_APP_SECRET=
# Supabase project URL, for example https://your-project.supabase.co
SUPABASE_URL=
# Origin the page is served from. Defaults to http://localhost:5173.
APP_ORIGIN=

# Browser (read by Vite)
# Same Supabase project URL as above.
VITE_SUPABASE_URL=
# Supabase anon (publishable) key.
VITE_SUPABASE_ANON_KEY=
# Reown project id from the Reown dashboard.
VITE_REOWN_PROJECT_ID=
